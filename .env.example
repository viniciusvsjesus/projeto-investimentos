# ==========================================================================
# Copie este arquivo para .env e preencha os valores.
#
#     cp .env.example .env
#
# O .env NÃO é versionado (ver .gitignore). Nunca coloque valor real aqui.
# ==========================================================================

# --- Fonte externa: BRAPI -------------------------------------------------
# Token do seu plano. Obtenha em https://brapi.dev/dashboard
# Sem token, apenas os tickers de sandbox respondem:
# PETR4, VALE3, MGLU3, ITUB4
BRAPI_TOKEN=cole-seu-token-aqui

BRAPI_BASE_URL=https://brapi.dev

# Caminho do endpoint de cotação. v2 é o endpoint ativo, confirmado no painel
# da BRAPI. Fica configurável para permitir voltar ao legado sem recompilar.
#   v2     : /api/v2/stocks/quote?symbols={ticker}
#   Legado : /api/quote/{ticker}
BRAPI_QUOTE_PATH=/api/v2/stocks/quote?symbols={ticker}

# Tempo limite, em segundos, para a chamada à fonte externa.
BRAPI_TIMEOUT_SECONDS=8.0

# --- Limites de consulta -------------------------------------------------
# Quantos ativos cabem numa requisição a GET /ticker.
#
# O padrão 3 é o teto assumido do plano gratuito. A documentação da BRAPI
# declara 10 no plano Startup e 20 no Pro, mas não publica o número do gratuito.
#
# ATENÇÃO: elevar acima do teto do seu plano exige implementar o fatiamento do
# lote antes — hoje uma chamada sempre basta porque este número é menor que o
# limite da fonte. Ver specs/002-multiplos-tickers/plan.md.
MAX_TICKERS_PER_REQUEST=3

# --- Cache ----------------------------------------------------------------
# Deixe vazio para desligar o cache (a API continua funcionando).
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60

# --- Aplicação ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Porta exposta no host. Mude se a 8000 já estiver ocupada.
API_PORT=8000
